# Copy this file to .env for local development.
# In production (Render), set these as environment variables in the
# dashboard instead — do NOT commit a real .env file.

ENVIRONMENT=development
SERVER_PORT=8080

# Postgres connection string.
# Local docker-compose default shown below.
DATABASE_URL=postgres://leaderboard:leaderboard@localhost:5432/leaderboard?sslmode=disable

# Redis connection.
# Local docker-compose default shown below. On Render, use the
# internal Redis URL's host:port and set REDIS_USE_TLS=true if using
# Render's managed Redis with TLS enabled.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_TLS=false

# JWT signing secret — use a long random string in production.
# You can generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRY_HOURS=72

# Comma-separated list of allowed CORS origins for the frontend.
ALLOWED_ORIGINS=http://localhost:4200

# Password used for all fake generator bot accounts (see
# cmd/generator). Required — the generator will refuse to start
# without it. Pick your own value; do not reuse any password shown in
# this repo's history or documentation.
GENERATOR_BOT_PASSWORD=change-this-generator-bot-password

# Secret that lets the bot generator skip rate limiting. Must be the
# same value for the server and the generator. Without it the server's
# login limit (10 per minute per IP) blocks the 500 bots. Generate one
# with: openssl rand -hex 24
RATE_LIMIT_BYPASS_TOKEN=change-this-rate-limit-bypass-token

# Set to true ONLY when the server runs behind a reverse proxy that
# adds the real client IP to X-Forwarded-For (Render does). Leave false
# locally, otherwise clients could fake their IP.
TRUST_PROXY_HEADER=false
